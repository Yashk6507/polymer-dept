PORT=5000
NODE_ENV=development

# JWT Secret (change this in production)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Maximum upload size per image, in bytes (default 5 MB)
MAX_FILE_SIZE=5242880

# Optional: point the JSON store somewhere else (used by the test suite)
# DATA_FILE=./data/store.json

# ==================================================================
# NOTIFICATION GATEWAYS — both are optional
#
# With nothing filled in the app still works: every task alert is kept in
# the in-app outbox and the dashboard reports "In-app only". Configuration
# alone is never reported as working delivery — the server verifies each
# gateway for real at startup and on demand from the dashboard.
# ==================================================================

# ------------------------------------------------------------------
# EMAIL — pick ONE provider. The default is SMTP via nodemailer.
#
# Option A — Brevo HTTP API (easiest if you already have a Brevo key)
#   Set BREVO_API_KEY to switch provider automatically; no SMTP values
#   are needed. Keys start with "xkeysib-" and come from
#   https://app.brevo.com/settings/keys/api
#   MAIL_FROM must be a sender address verified in your Brevo account.
#   If sends are rejected with "unrecognised IP address", your account has an
#   IP restriction turned on: add your IP (or disable the restriction) at
#   https://app.brevo.com/security/authorised_ips
# ------------------------------------------------------------------
# EMAIL_PROVIDER=brevo          # optional; inferred when BREVO_API_KEY is set
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com

# ------------------------------------------------------------------
# EMAIL — Option B — SMTP. Requires the nodemailer package.
# Brevo users can also use the SMTP relay instead of the API:
#   SMTP_HOST=smtp-relay.brevo.com, port 587, SMTP_SECURE=false,
#   SMTP_USER = your Brevo login e-mail, SMTP_PASS = an smtp key (xsmtpsib-...)
# Gmail:      smtp.gmail.com, port 587, SMTP_SECURE=false,
#             SMTP_PASS must be a 16-character App Password
#             (https://support.google.com/accounts/answer/185833)
# Office365:  smtp.office365.com, port 587, SMTP_SECURE=false
# College mail server: ask IT for the host, port and whether TLS is on
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Polymer Department <no-reply@polymer.edu>
# Give up on an unreachable mail server rather than hanging the request
SMTP_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# SMS — supported providers: none | twilio | fast2sms
#
# twilio     works internationally. Needs a paid account and a
#            verified/purchased sender number.
# fast2sms   cheapest for Indian numbers, but needs a DLT-registered
#            sender ID (SMS_SENDER_ID) and template approval.
#
# With SMS_PROVIDER=none (the default) no SMS is ever attempted.
# ------------------------------------------------------------------
SMS_PROVIDER=none
SMS_SENDER_ID=
SMS_TIMEOUT_MS=10000

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional — Twilio publishes regional edge URLs (e.g. https://api.sydney.us1.twilio.com)
TWILIO_API_BASE_URL=https://api.twilio.com

# Fast2SMS (India, https://www.fast2sms.com) — route "q" is the quick/transactional route
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
# Optional — override only if Fast2SMS changes its API host
FAST2SMS_API_BASE_URL=https://www.fast2sms.com
